<% layout("/layouts/boilerplate") %>

    <div class="row mb-4">
        <div class="col-6 offset-3">
            <form class="new-form needs-validation" method="POST" action="/signup" novalidate>
                <div class="mb-3">
                    <label for="title" class="form-label">Username</label>
                    <input type="text" class="form-control" name="" id="username" placeholder="Enter username"
                        required>
                    <div class="invalid-feedback"> Enter a username</div>
                </div>
                <div class="mb-3">
                    <label for="title" class="form-label">Email</label>
                    <input type="email" class="form-control" name="" id="email" placeholder="Enter email"
                        required>
                    <div class="invalid-feedback"> Enter email</div>
                </div>
                
                <div class="mb-3">
                    <label for="title" class="form-label">Password</label>
                    <input type="password" class="form-control" name="password" id="password" placeholder="Enter password"
                        required>
                    <div class="invalid-feedback"> Enter password</div>
                </div>
                
            </form>
        </div>
    </div>