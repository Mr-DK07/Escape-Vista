<% layout("/layouts/boilerplate") %>

    <body>
        <h5 class="offset-2"><b>Update Listing-</b></h5>
        <div class="row m-3">
            <div class="col-8 offset-2">
                <form class="edit-form needs-validation" enctype="multipart/form-data" method="POST"
                    action="/listings/<%= listing._id %>?_method=PUT" novalidate>
                    <div>
                        <label class="form-label mt-3 mb-0" for="title">Title</label>
                        <input type="text" class="form-control" name="listing[title]" id="title"
                            value="<%= listing.title %>" required>
                        <div class="invalid-feedback"> Enter a short title.</div>
                    </div>
                    <div class="mt-2">
                        <h6>Original image</h6>
                        <img src="<%= originalImageUrl %>" alt="old image" style="max-width: 10rem; max-height: 6rem;">
                    </div>
                    <div>
                        <label class="form-label mt-3 mb-0" for="image">Image</label>
                        <input type="file" class="form-control" name="listing[image]" id="image" required>
                        <div class="invalid-feedback"> Upload image!</div>
                    </div>
                    <div>
                        <label class="form-label mt-3 mb-0" for="description">Description</label>
                        <textarea type="text" class="form-control" name="listing[description]" id="description"
                            required><%= listing.description %></textarea>
                        <div class="invalid-feedback"> Enter description.</div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <label class="form-label mt-3 mb-0" for="price">Price</label>
                            <input type="number" class="form-control" name="listing[price]" id="price"
                                value="<%= listing.price %>" required>
                            <div class="invalid-feedback"> Enter valid price.</div>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label mt-3 mb-0" for="country">Country</label>
                            <input type="text" class="form-control" name="listing[country]" id="country"
                                value="<%= listing.country %>" required>
                            <div class="invalid-feedback"> Enter country name.</div>
                        </div>
                    </div>
                    <div class="row">
                    <div class="col-md-4">
                        <label for="category" id="category" class="form-label mt-3 mb-0">
                            Category
                        </label>
                        <select class="form-control" id="category" name="listing[category]" required>
                            <option value="" disabled selected>Select category:</option>
                            <option value="Trending">Trending</option>
                            <option value="Iconic City">Iconic City</option>
                            <option value="Mountain">Mountain</option>
                            <option value="Castle">Castle</option>
                            <option value="Pool">Pool</option>
                            <option value="Camping">Camping</option>
                            <option value="Farm">Farm</option>
                            <option value="Arctic">Arctic</option>
                            <option value="Spa">Spa</option>
                            <option value="Adventure">Adventure</option>
                            <option value="Dining">Dining</option>
                            <option value="Meeting">Meeting</option>
                        </select>
                        <div class="invalid-feedback">Select any one.</div>
                    </div>
                    
                        <div class="col-md-8">
                            <label class="form-label mt-3 mb-0" for="location">Location</label>
                            <input type="text" class="form-control" name="listing[location]" id="location"
                                value="<%= listing.location %>" required>
                            <div class="invalid-feedback"> Enter location.</div>
                        </div>
                        </div>

                        <button class="btn mt-3">Update</button>
                </form>
            </div>
        </div>
    </body>