<% layout("/layouts/boilerplate") %>

    <body>
        <h5 class="offset-2"><b>Update Listing-</b></h5>
        <div class="row m-3">
            <div class="col-8 offset-2">
                <form class="edit-form needs-validation" method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate>
                    <div>
                        <label class="form-label mt-3 mb-0" for="title">Title</label>
                        <input type="text" class="form-control" name="listing[title]" id="title" value="<%= listing.title %>" required>
                    </div>
                    <div>
                        <label class="form-label mt-3 mb-0" for="image">Image</label>
                        <input type="text" class="form-control" name="listing[image]" id="image" value="<%= listing.image %>" required>
                    </div>
                    <div>
                        <label class="form-label mt-3 mb-0" for="description">Description</label>
                        <textarea type="text" class="form-control" name="listing[description]" id="description"
                            required><%= listing.description %></textarea>
                    </div>
                    <div class="row">
                    <div class="col-md-4">
                        <label class="form-label mt-3 mb-0" for="price">Price</label>
                        <input type="number" class="form-control" name="listing[price]" id="price" value="<%= listing.price %>" required>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label mt-3 mb-0" for="country">Country</label>
                        <input type="text" class="form-control" name="listing[country]" id="country" value="<%= listing.country %>" required>
                    </div>
                </div>
                    <div>
                        <label class="form-label mt-3 mb-0" for="location">Location</label>
                        <input type="text" class="form-control" name="listing[location]" id="location" value="<%= listing.location %>"
                            required>
                    </div>
                    
                    <button class="btn mt-3">Update</button>
                </form>
            </div>
        </div>
    </body>