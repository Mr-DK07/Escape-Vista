<% layout("/layouts/boilerplate") %>

<div class="mt-3">
	<!-- Display Flash Message -->
	<% if (error) { %>
	<div><%= error %></div>
	<% } %>

	<!-- Display Listings-->
	<% if (listings.length === 0) { %>
	<h3 class="centre p-3 m-auto">
		No locations found for your search.
	</h3>
	<% } else { %>
	<div class="row row-cols-lg-3 row-cols-md-2 mt-3">
		<% listings.forEach(function(listing) { %>
		<a href="/listings/<%= listing.id %>" class="search-card-link">
			<div class="card col listing-card">
				<img src="<%= listing.image.url %>" class="card-img-top rounded" alt="search_image" style="height: 22rem" />
				<div class="card-body">
					<b><%= listing.title %></b>
					<p>
						<b>&#8377; </b> <%= listing.price.toLocaleString("en-IN") %> / night
						<b class="tax-info"> + 18% GST</b>
					</p>
				</div>
			</div>
		</a>
		<% }); %>
	</div>
	<% } %>
</div>