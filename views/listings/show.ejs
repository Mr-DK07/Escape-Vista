<% layout("/layouts/boilerplate") %>

    <body>
        <div class="row">
            <div class="col-8 offset-3">
                <h3>
                    <%= listing.title %>
                </h3>
            </div>
        </div>
        <div class="row">
            <div class="card listing-card col-6 offset-3">
                <img src="<%= listing.image %>" class="show-img card-img-top" alt="img..">
                <div class="show-card-body my-3">
                    <p class="card-text">
                        <%= listing.description %>
                    </p>
                    <p class="my-2"><b>&#8377; </b>
                        <%= listing.price.toLocaleString("en-IN") %> /night
                    </p>
                    <p>
                        <i class="fa-solid fa-location-dot"></i>
                        <%= listing.location %>
                    </p>
                    <p>
                        <%= listing.country %>
                    </p>
                </div>
                <div class="edit-delete-btn mt-4">
                    <a href="/listings/<%= listing._id %>/edit">
                        <button class="btn btn-danger px-4">Edit</button>
                    </a>
                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                        <button class="btn btn-dark ms-5 px-3">Delete</button>
                    </form>
                </div>
            </div>
        </div>
        <hr>

        <!-- review form -->
        <div class="row">
            <div class="col-6 offset-3">
                <h5><b><u>Leave a Review</u></b></h5>
                <form action="/listings/<%= listing.id %>/reviews" method="POST" class="needs-validation" novalidate>
                    <div>
                        <label class="form-label" for="rating">Rating : </label>
                        <input type="range" min="1" max="5" id="rating" name="review[rating]">
                    </div>
                    <div>
                        <label class="form-label" for="comment">Comment</label>
                        <textarea class="form-control" name="review[comment]" id="comment" required></textarea>
                        <div class="invalid-feedback"> Comment box cannot be blank.</div>
                    </div>
                    <button class="btn btn-success mt-3">
                        Submit
                    </button>
                </form>
            </div>
        </div>
        <div class="row mt-5 ">
            <div class="col-8  offset-3">
                <p><b><u>All Reviews</u></b></p>
                <div class="row ">
                    <% for(review of listing.reviews) { %>
                        <div class="card col-5 my-2 me-3 ps-2">
                            <div class="card-body">
                                <div class="mt-2 d-flex justify-content-between">
                                    <h6 class="card-title ">
                                        <b>Jane Doe</b>
                                    </h6>
                                    <div class="edit-delete d-flex justify-content-between">
                                        <form class="edit-review" method="POST" action="#">
                                            <button class="btn border-success px-1 py-0 me-1 "><i
                                                    class="fa-solid fa-pencil fa-sm"></i></button>
                                        </form>
                                        <form class="delete-review" method="POST"
                                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                            <button class="btn border-success px-1 py-0"><i class="fa-solid fa-trash fa-sm"></i></button>
                                        </form>
                                    </div>
                                </div>
                                <p class="card-text mb-1">
                                   <b> <%= review.rating %> <i class="fa-solid fa-star" style="color: #FFD43B;"></i></b> 
                                </p>
                                <p class="card-text">
                                    <%= review.comment %>
                                </p>

                            </div>
                        </div>
                        <% } %>
                </div>
            </div>
        </div>

    </body>