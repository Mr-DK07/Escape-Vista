<% layout("/layouts/boilerplate") %>

	<body>
		<h4>
			<b><%= category %> Locations:</b>
		</h4>

		<br />
		<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
			<% if (listings.length===0) { %>
				<p>No location found in this category.</p>
				<% } else { %>
					<% listings.forEach(function(listing) { %>
						<a href="/listings/<%= listing._id %>" class="category-link">
							<div class="card col category-card">
								<img src="<%= listing.image.url %>" class="card-img-top category-img" alt="category_image"
									style="height: 22rem" />
								<div class="card-img-overlay"></div>
							</div>

							<div class="category-card-body">
								<p class="card-text">
									<b>
										<%= listing.title %>
									</b>
								</p>
								<p>
									&#8377; <%= listing.price.toLocaleString("en-IN") %> / night
										<b class="tax-info">+ 18% GST</b>
								</p>
							</div>
							<br />
						</a>
						<% }); %>
				<% } %>
		</div>
	</body>